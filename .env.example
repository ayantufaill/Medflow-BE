# ============================================================
# MedFlow Backend — Local Development .env
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ============================================================

# Server
PORT=5001
NODE_ENV=development

# SQL Server — local instance (see LOCAL_DEVELOPMENT.md for setup)
# Format: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1434;database=schema_test;user=sa;password=StrongPassw0rd!2026;encrypt=true;trustServerCertificate=true"

# JWT — use any long random string locally, rotate in production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Seed admin account (used by npm run seed:users)
SEED_ADMIN_EMAIL=admin@medflow.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# Frontend URL (used inside password-reset/invite emails)
FRONTEND_URL=http://localhost:5173

# Email
# "console"  → prints emails to terminal (good for local dev, no config needed)
# "gmail"    → requires EMAIL_USER + EMAIL_PASSWORD (App Password, not login password)
# "smtp"     → requires SMTP_HOST, SMTP_USER, SMTP_PASSWORD
EMAIL_PROVIDER=console
EMAIL_USER=
EMAIL_PASSWORD=
FROM_EMAIL=noreply@medflow.com
FROM_NAME=MedFlow

# AWS S3 — document/file uploads (optional; leave blank to disable)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
AWS_S3_BUCKET_NAME=
AWS_S3_BASE_URL=

# Google Cloud Vision — OCR feature (optional; leave blank to disable)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=
