# App
NODE_ENV=
PORT=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=

# Database
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Runtime connection. MUST be the medflow_app role, not postgres: a superuser
# or table owner bypasses Row-Level Security, and the app refuses to boot in
# production when that is the case (see src/config/db.ts).
DATABASE_URL=
# Owner connection. Used only for `prisma db push` and scripts/applyRls.
DIRECT_DATABASE_URL=
# Password for the medflow_app role. Injected into prisma/rls/01-app-role.sql
# by scripts/applyRls.ts and re-synced on every deploy, so rotating this value
# rotates the live database credential. Generate with: openssl rand -base64 32
APP_DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Email
EMAIL_PROVIDER=
EMAIL_USER=
EMAIL_PASSWORD=
FROM_EMAIL=
FROM_NAME=

# Provider for practice texting numbers (Email & Messaging → Number Selection).
# One of: twilio, local. Blank = twilio when its credentials are set, else local
# (demo 555-01xx numbers). New providers: src/services/messaging-providers/.
MESSAGING_PROVIDER=

# SMS (Twilio) - leave blank to fall back to console logging in dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp (Twilio) - defaults to Twilio's public sandbox number/template if left blank
TWILIO_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_CONTENT_SID=

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_S3_BASE_URL=

# Google Cloud Vision (optional)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=
