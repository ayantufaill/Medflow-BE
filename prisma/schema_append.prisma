

model clinicalcategory {
  id            Int                   @id @default(autoincrement())
  name          String                @unique
  subCategories clinicalsubcategory[]
}

model clinicalsubcategory {
  id         Int              @id @default(autoincrement())
  name       String
  categoryId Int
  category   clinicalcategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items      clinicalitem[]

  @@unique([name, categoryId])
}

model clinicalitem {
  id            Int                 @id @default(autoincrement())
  subCategoryId Int
  choiceName    String
  isDefault     Boolean             @default(false)
  instructions  String?
  price         Float               @default(0)
  code          String?
  isQuickList   Boolean?
  isRecommended Boolean?
  subCategory   clinicalsubcategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
}
